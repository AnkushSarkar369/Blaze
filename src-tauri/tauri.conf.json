{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blaze",
  "version": "0.1.0",
  "identifier": "com.ankushsarkar.blaze",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-media-tools.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blaze",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../BIN/": "BIN/"
    },
    "category": "Video",
    "shortDescription": "Clean your footage up.",
    "longDescription": "A fast, local-first video utility for cleaning up raw footage."
  }
}
